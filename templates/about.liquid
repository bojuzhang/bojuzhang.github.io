  Adapted from alshedivat/al-folio v0.14.6, _layouts/about.liquid.
  See assets/licenses/al-folio.txt.
{% endcomment %}
<div class="post about">
  <header class="post-header">
    <h1 class="post-title">{{ profile.name }}</h1>
    {% if profile.subtitle %}<p class="desc">{{ profile.subtitle }}</p>{% endif %}
  </header>
  <article>
    <div class="biography">
      {% if profile.image %}
        <figure class="profile"><img src="{{ profile.image }}" alt="{{ profile.alt }}"></figure>
      {% endif %}
      {% if profile.location %}<p class="location">{{ profile.location }}</p>{% endif %}
      {% for paragraph in paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
    </div>
    {% if news %}
      <section class="home-section" aria-labelledby="news-heading">
        <h2 id="news-heading"><a href="{{ news.href }}">{{ news.title }}</a></h2>
        {% if news.items.size > 0 %}
          <ul class="news-summary">
            {% for item in news.items %}
              <li><time datetime="{{ item.date }}">{{ item.date }}</time><span>{% if item.href %}<a href="{{ item.href }}">{{ item.text }}</a>{% else %}{{ item.text }}{% endif %}</span></li>
            {% endfor %}
          </ul>
        {% else %}<p class="empty-note">{{ news.empty }}</p>{% endif %}
      </section>
    {% endif %}
    {% if selected %}
      <section class="home-section" aria-labelledby="papers-heading">
        <h2 id="papers-heading"><a href="{{ selected.href }}">{{ selected.title }}</a></h2>
        {% if selected.html %}{{ selected.html | raw }}{% else %}<p class="empty-note">{{ selected.empty }}</p>{% endif %}
      </section>
    {% endif %}
    {% if socials.size > 0 %}
      <div class="social">{% for link in socials %}<a href="{{ link.href }}">{{ link.label }}</a>{% endfor %}</div>
    {% endif %}
  </article>
</div>
