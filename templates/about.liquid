{% comment %}
  Adapted from alshedivat/al-folio v0.14.6, _layouts/about.liquid.
  See assets/licenses/al-folio.txt.
{% endcomment %}
<div class="post about">
  <div class="intro">
    <div class="intro-copy">
      <header class="post-header">
        <h1 class="post-title">{% if profile.name %}{{ profile.name }}{% else %}<strong>{{ heroFirst }}</strong>{{ heroLast }}{% endif %}</h1>
        {% if profile.subtitle %}<p class="desc">{{ profile.subtitle }}</p>{% endif %}
        {% if profile.location %}<p class="location">{{ profile.location }}</p>{% endif %}
      </header>
      <div class="biography">
        {% for paragraph in paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
      </div>
      {% if buttons.size > 0 %}<div class="intro-actions">
        {% for button in buttons %}<a class="action{% if forloop.first %} primary{% endif %}" href="{{ button.href }}">{{ button.label }}</a>{% endfor %}
      </div>{% endif %}
      {% if socials.size > 0 %}<div class="social">{% for link in socials %}<a href="{{ link.href }}">{{ link.label }}</a>{% endfor %}</div>{% endif %}
    </div>
    <figure class="profile">
      <img src="{{ profile.image }}" alt="{{ profile.alt }}" fetchpriority="high" width="720" height="800">
    </figure>
  </div>
  <div class="highlights">
    {% if selected %}
      <section class="home-section" aria-labelledby="papers-heading">
        <h2 id="papers-heading"><a href="{{ selected.href }}">{{ selected.title }}</a></h2>
        {% if selected.html %}{{ selected.html | raw }}{% else %}<p class="empty-note">{{ selected.empty }}</p>{% endif %}
        <a class="text-link" href="{{ selected.href }}">{{ selected.label }}</a>
      </section>
    {% endif %}
    {% if news %}
      <section class="home-section" aria-labelledby="news-heading">
        <h2 id="news-heading"><a href="{{ news.href }}">{{ news.title }}</a></h2>
        {% if news.items.size > 0 %}
          <ul class="news-summary">{% for item in news.items %}
            <li><time datetime="{{ item.date }}">{{ item.date }}</time> {% if item.href %}<a href="{{ item.href }}">{{ item.text }}</a>{% else %}{{ item.text }}{% endif %}</li>
          {% endfor %}</ul>
        {% else %}<p class="empty-note">{{ news.empty }}</p>{% endif %}
        <a class="text-link" href="{{ news.href }}">{{ news.label }}</a>
      </section>
    {% endif %}
  </div>
</div>
